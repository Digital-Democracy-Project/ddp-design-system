root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2
tab_width = 2

# YAML doesn't allow tabs.
[*.{yml,yaml}]
indent_style = space

# Trailing spaces are line breaks in Markdown.
[*.md]
trim_trailing_whitespace = false
